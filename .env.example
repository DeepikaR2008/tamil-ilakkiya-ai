# Tamil Ilakkiya AI - Environment Configuration

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Embedding Model (Multilingual supporting Tamil and English)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=database/chroma_db
CHROMA_COLLECTION_NAME=tamil_ilakkiya_corpus

# Retrieval Defaults
DEFAULT_TOP_K=5
CONFIDENCE_THRESHOLD=0.65
